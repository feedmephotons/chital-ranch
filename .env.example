# Copy to .env.local and fill in.

# Supabase project that receives contact + visit form submissions.
# The publishable key is safe in the browser: the anon role is granted
# INSERT on form_submissions and nothing else.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Google Gemini key for the RanchAI assistant.
GEMINI_API_KEY=
